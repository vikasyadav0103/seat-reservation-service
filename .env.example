# Select one Spring profile automatically: local or prod
APP_ENV=local

# Existing local or office PostgreSQL instance; Compose does not create a database container.
LOCAL_DB_HOST=your-local-postgres-host
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=your-local-database
LOCAL_DB_USERNAME=your-local-username
LOCAL_DB_PASSWORD=your-local-password
LOCAL_DB_SSL_MODE=disable

# Neon production settings; leave APP_ENV=local for local testing
PROD_DB_HOST=your-neon-pooled-host
PROD_DB_PORT=5432
PROD_DB_NAME=your-neon-database
PROD_DB_USERNAME=your-neon-username
PROD_DB_PASSWORD=your-neon-password
PROD_DB_SSL_MODE=require
PROD_DB_CHANNEL_BINDING=require

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
